---
// Placeholder photos; replace `src` with files in public/mocha/gallery/ later.
const photos = [
	{ src: "https://picsum.photos/seed/mocha-1/900/600", alt: "MOCHA session photo 1" },
	{ src: "https://picsum.photos/seed/mocha-2/600/700", alt: "MOCHA session photo 2" },
	{ src: "https://picsum.photos/seed/mocha-3/1000/800", alt: "MOCHA session photo 3" },
	{ src: "https://picsum.photos/seed/mocha-4/600/800", alt: "MOCHA session photo 4" },
	{ src: "https://picsum.photos/seed/mocha-5/1000/700", alt: "MOCHA session photo 5" },
	{ src: "https://picsum.photos/seed/mocha-6/700/600", alt: "MOCHA session photo 6" },
	{ src: "https://picsum.photos/seed/mocha-7/700/600", alt: "MOCHA session photo 7" },
];
---

<div class="gallery">
	{
		photos.map((p, i) => (
			<figure class={`g${i + 1}`}>
				<img src={p.src} alt={p.alt} loading="lazy" />
			</figure>
		))
	}
</div>
