---
/**
 * The cosmic web, evolving in the page margins as you scroll.
 *
 * The two bands show two windows either side of the most massive cluster in the
 * IllustrisTNG frame -- the left band carries that cluster, the right band the
 * second-ranked one. Scrolling from the top of the page to the bottom advances
 * cosmic time from z = 6 to z = 0.
 *
 * The framing crops the movie's own burned-in scale bar and redshift readout out
 * of shot, so both are redrawn here as DOM elements. That is not just a
 * workaround: the band cover-crop discards the top of the frame entirely at wide
 * viewports, and .cw-band is inverted in light mode, so anything painted into the
 * image would be cut off, inverted, or both. As markup they also update
 * continuously rather than stepping between the 90 discrete frames.
 *
 * Decoration only: aria-hidden, pointer-events none, and hidden entirely below
 * 1100px, on reduced-motion, in print, and on constrained connections.
 *
 * The <script> below must carry no attributes other than src -- Astro skips
 * bundling any script that has one, which would silently leave this unprocessed.
 * That is also why `frameWindow` travels to the script as a data attribute rather
 * than as an argument.
 */

interface Props {
	/**
	 * Decoded frames held at once. Omitted means the script's own default of 12
	 * (~47 MB). A page that spends its memory on its own imagery can ask for
	 * fewer; the proxy atlas covers the gaps at reduced resolution.
	 */
	frameWindow?: number | undefined;
}

const { frameWindow } = Astro.props;
---

<div class="cw" aria-hidden="true" data-cw-window={frameWindow}>
	<canvas class="cw-band cw-band--left" data-cw-left></canvas>
	<canvas class="cw-band cw-band--right" data-cw-right></canvas>
	<div class="cw-readout cw-readout--scale" data-cw-scale>
		<span class="cw-rule" data-cw-rule></span>
		<span data-cw-scale-label></span>
	</div>
	<div class="cw-readout cw-readout--z" data-cw-z></div>
</div>

<style>
	.cw {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
		/* Guarantees the bands can never invalidate layout in the content column. */
		contain: strict;

		/* Breathing room between the band and the text column. */
		--cw-gutter: 2rem;
		/* Distance over which the band fades out toward the text. Absolute rather
		   than a percentage of the band, so the fade looks the same at every
		   viewport width instead of steepening as the band narrows. */
		--cw-fade: 9rem;
	}

	.cw-band {
		position: absolute;
		inset-block: 0;
		/* Whatever the centred column leaves over, less the gutter. 48rem is
		   Base.astro's max-w-3xl.

		   100dvw, not 100vw: 100vw includes the classic scrollbar while the centred
		   body is laid out inside clientWidth, so on a machine set to always show
		   scrollbars the right band used to creep ~7.5px under the column. */
		inline-size: max(0px, calc((100dvw - 48rem) / 2 - var(--cw-gutter)));
		block-size: 100%;
		opacity: 0.55;
		/* Static frame, so the margins are never empty: covers no-JS, reduced
		   motion, slow connections and the moments before the first decode. */
		background-image: url("/cosmic-web/static.avif");
		background-repeat: no-repeat;
		background-size: 200% 100%;
	}

	.cw-band--left {
		inset-inline-start: 0;
		background-position: left center;
		/* Fade toward the text, not toward the page edge. */
		mask-image: linear-gradient(to right, black calc(100% - var(--cw-fade)), transparent 100%);
	}

	.cw-band--right {
		inset-inline-end: 0;
		background-position: right center;
		mask-image: linear-gradient(to left, black calc(100% - var(--cw-fade)), transparent 100%);
	}

	/* The frames are bright structure on black: right at home in dark mode, but
	   dark smudges on white. Inverting in light mode reads as a plate negative. */
	:global(html[data-theme="light"]) .cw-band,
	:global(html:not([data-theme="dark"])) .cw-band {
		filter: invert(1);
		opacity: 0.4;
	}

	/* --- Redrawn readouts ---------------------------------------------------
	   Siblings of the canvases, never children: .cw-band is inverted in light
	   mode, and a canvas cannot have children anyway. Laid out to mirror the
	   source movie -- scale bar top-left, redshift top-right.

	   Hidden until the script sets a value. Without that, a visitor with no
	   JavaScript, reduced motion, or a slow first decode would be shown an empty
	   rule and no number, which reads as broken rather than as decoration. */
	.cw-readout {
		position: absolute;
		inset-block-start: 1.5rem;
		visibility: hidden;
		font-size: 0.75rem;
		line-height: 1.4;
		letter-spacing: 0.02em;
		color: var(--color-muted);
		/* The band underneath peaks at a mid grey, but a cluster core is the one
		   place it gets close to the text colour. A shadow in the page's own
		   background colour keeps the glyphs legible there without drawing a box. */
		text-shadow:
			0 0 4px var(--color-global-bg),
			0 0 8px var(--color-global-bg);
	}

	.cw--live .cw-readout {
		visibility: visible;
	}

	/* 1.5rem in from the page edge: the outer edge of the band is the part the
	   fade mask leaves solid, so the readouts sit over image rather than over
	   bare background even in the narrowest 134px band. */
	.cw-readout--scale {
		inset-inline-start: 1.5rem;
	}

	.cw-readout--z {
		inset-inline-end: 1.5rem;
		text-align: end;
	}

	/* Width is set by the script, to the exact pixel length of the labelled
	   physical distance at the current redshift. */
	.cw-rule {
		display: block;
		block-size: 1px;
		margin-block-end: 0.25rem;
		background: currentcolor;
	}

	/* Below this the margins have collapsed and there is nothing to draw into.
	   The JS checks the same breakpoint before fetching anything. */
	@media (max-width: 1099px), (max-height: 599px) {
		.cw {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cw-band {
			/* Static frame stays; the script never boots. */
			opacity: 0.35;
		}
	}

	@media print {
		.cw {
			display: none;
		}
	}
</style>

<script>
	import { initCosmicBands } from "@/scripts/cosmic-bands";

	void initCosmicBands();
</script>
