---
import { menuLinks, siteConfig } from "@/site.config";

const year = new Date().getFullYear();
---

{/*
	Both rows are sized to stay on ONE line at every width, including a 390px
	phone. The type is text-xs everywhere (not just at sm:) and the links use
	px-3 with no gap: five items then measure 333px against the 358px a phone
	gives us, and 689px of the 704px column on desktop -- which is what stops the
	copyright line wrapping too. It used to miss by under two pixels at 768px.

	The two rows sit side by side only from md:. At sm: (640px) the column is
	just 576px, and copyright + nav need 668px, so they stack there instead --
	still one line each.

	Do not restore flex-wrap. Wrapping was a previous fix for the nav overflowing
	the viewport; the real fix is fitting, and any change here must be re-checked
	for horizontal overflow at 390px, not just for line count. 640px is the
	tightest desktop case, not 768px.
*/}
<footer
	class="text-muted mt-auto flex w-full flex-col items-center justify-center gap-y-2 pt-20 pb-4 text-center align-top text-xs font-semibold md:flex-row md:justify-between"
>
	<div class="me-0 font-normal md:me-4">
		{/* The space before <span> is written explicitly: Astro trims the newline
		    between a text node and a following element, which ran the two
		    sentences together as "Koonkor.Built on". */}
		&copy; {year} {siteConfig.author}.{" "}<span class="inline-block">
			Built on <a
				class="hover:text-global-text hover:underline"
				href="https://github.com/chrismwilliams/astro-theme-cactus"
				rel="noreferrer"
				target="_blank">Astro Cactus</a
			>.
		</span>
	</div>
	<nav aria-label="Footer" class="divide-muted flex justify-center divide-x">
		{
			menuLinks.map((link) => (
				<a class="hover:text-global-text px-3 py-1 hover:underline md:py-0" href={link.path}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
