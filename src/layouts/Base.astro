---
import BaseHead from "@/components/BaseHead.astro";
import CosmicBands from "@/components/CosmicBands.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	/**
	 * The margin animation is decorative and holds ~47 MB of decoded frames at its
	 * default window.
	 *
	 *   true    full window, which is every page but one
	 *   "light" a 4-frame window, ~16 MB, for a page that spends its own memory
	 *           budget on imagery -- the structure-growth demo holds two windows
	 *           of 512x512 bitmaps of its own
	 *   false   not mounted at all
	 */
	bands?: boolean | "light";
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title },
	bands = true,
} = Astro.props;

const bandWindow = bands === "light" ? 4 : undefined;
---

<html class="scroll-smooth" lang={siteConfig.lang}>
	<head>
		<BaseHead articleDate={articleDate} description={description} ogImage={ogImage} title={title} />
		<ThemeProvider />
	</head>
	<body
		class="bg-global-bg text-global-text site-column mx-auto flex min-h-screen flex-col px-4 pt-16 font-mono text-sm font-normal antialiased sm:px-8"
	>
		{bands && <CosmicBands frameWindow={bandWindow} />}
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
	</body>
</html>
