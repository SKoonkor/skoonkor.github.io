---
import { getCollection } from "astro:content";
import DemoThumb from "@/components/DemoThumb.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import PageTitle from "@/components/PageTitle.astro";
import { demos } from "@/data/demos";
import { software } from "@/data/software";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import "@/styles/software.css";

const notes = (await getCollection("post", ({ data }) => !data.draft)).sort(collectionDateSort);

const meta = {
	description:
		"Interactive versions of my astrophysics research, plus notes and references worth sharing.",
	title: "Explore",
};
---

<PageLayout meta={meta}>
	<PageTitle title="Explore" />

	<div data-pagefind-body>
		<p class="mb-10 text-base leading-relaxed text-pretty">
			Some of my research, turned into something you can actually play with. Everything here runs in
			your browser, from the same numbers behind the papers.
		</p>

		<ul class="explore-cards" role="list">
			{
				demos.map(({ href, title, blurb, thumb }) => (
					<li class={href ? undefined : "soon"}>
						{href ? (
							<a href={href}>
								<h2>{title}</h2>
								<div class="explore-cards__body">
									{thumb && <DemoThumb name={thumb} />}
									<p>{blurb}</p>
								</div>
							</a>
						) : (
							<div class="block h-full p-6">
								<h2>{title} &middot; coming soon</h2>
								<p>{blurb}</p>
							</div>
						)}
					</li>
				))
			}
		</ul>

		{/* Software: the things I build outside research. Was its own top-level nav
		    item; folded in here so the nav bar has room for Courses instead. */}
		<section class="mt-20" id="software">
			<h2 class="title mb-6 text-xl">Software</h2>
			<p class="mb-6 text-sm leading-relaxed text-pretty">
				Software I write outside research, for the same reason I write papers: to find out
				whether I have actually understood something.
			</p>
			<ul class="explore-cards" role="list">
				{
					software.map(({ href, title, blurb, thumb, stack }) => (
						<li class={href ? undefined : "soon"}>
							{href ? (
								<a href={href}>
									<h2>{title}</h2>
									<div class="explore-cards__body">
										{thumb && <DemoThumb name={thumb} />}
										<div>
											<p>{blurb}</p>
											{stack && <p class="explore-cards__stack">{stack}</p>}
										</div>
									</div>
								</a>
							) : (
								<div class="block h-full p-6">
									<h2>{title} &middot; coming soon</h2>
									<p>{blurb}</p>
								</div>
							)}
						</li>
					))
				}
			</ul>
		</section>

		{/* Journal club: a link out to the MOCHA page, which has its own theme. */}
		<section class="mt-20">
			<h2 class="title mb-6 text-xl">Journal club</h2>
			<ul class="explore-cards" role="list">
				<li>
					<a href="/mocha/">
						<h2>MOCHA Journal Club</h2>
						<div class="explore-cards__body">
							<p>
								Morning Coffee Hurried arXiv, NARIT's paper-sharing club. See the format and sign up to
								present.
							</p>
						</div>
					</a>
				</li>
			</ul>
		</section>

		{
			notes.length > 0 && (
				<section class="mt-20">
					<h2 class="title mb-6 text-xl">Written</h2>
					<ul class="space-y-4" role="list">
						{notes.map((note) => (
							<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
								<FormattedDate
									class="text-muted min-w-30 font-semibold"
									date={note.data.publishDate}
								/>
								<div>
									<a class="cactus-link" href={`/explore/notes/${note.id}/`}>
										{note.data.title}
									</a>
									<p class="text-muted mt-0.5 text-xs leading-relaxed text-pretty">
										{note.data.description}
									</p>
								</div>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</PageLayout>
