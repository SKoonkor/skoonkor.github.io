---
import { getCollection } from "astro:content";
import PageTitle from "@/components/PageTitle.astro";
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";
import { papers } from "@/data/publications";

const research = (await getCollection("research", ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
const featured = research.slice(0, 3);
const latestPaper = papers[0];
---

<PageLayout meta={{ title: "Home" }}>
	<PageTitle title="Suttikoon Koonkor" />

	<section>
		<p class="text-muted mb-6 text-xs tracking-[0.2em] uppercase">
			Postdoctoral Researcher in Astrophysics &middot; NARIT
		</p>
		<p class="mb-4 text-base leading-relaxed text-pretty">
			I study how galaxies &mdash; the <em>light</em> &mdash; trace the dark matter they formed in.
			Welcome to my corner of the internet: a space for someone wandering the Universe with a great
			deal of curiosity.
		</p>
		<SocialList />
	</section>

	{
		latestPaper && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Latest paper</h2>
				<p class="text-muted text-xs leading-relaxed">
					{latestPaper.authors.map(({ name, self }, i) => (
						<>
							{i > 0 && ", "}
							{self ? <strong class="text-global-text">{name}</strong> : name}
						</>
					))}
					{latestPaper.etAl && ", et al."}
				</p>
				<p class="mt-1 mb-1 text-base leading-snug text-pretty">{latestPaper.title}</p>
				<p class="text-muted text-xs">
					<em>{latestPaper.venue}</em>, {latestPaper.year}
					{latestPaper.links.map(({ label, href }) => (
						<>
							{" · "}
							<a class="cactus-link" href={href} rel="noreferrer" target="_blank">
								{label}
							</a>
						</>
					))}
				</p>
			</section>
		)
	}

	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/research/">Research</a></h2>
		<ul class="space-y-6" role="list">
			{
				featured.map((entry) => (
					<li>
						<a class="cactus-link text-base" href={`/research/${entry.id}/`}>
							{entry.data.shortTitle ?? entry.data.title}
						</a>
						<p class="text-muted mt-1 text-sm leading-relaxed text-pretty">{entry.data.hook}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/explore/">Explore</a></h2>
		<p class="text-muted text-sm leading-relaxed text-pretty">
			Some of my research, turned into something you can actually play with. Everything runs in your
			browser, from the same numbers behind the papers.
		</p>
		<p class="mt-3">
			<a class="cactus-link text-base" href="/explore/pca-sed/">Rebuilding starlight</a>
			<span class="text-muted text-sm">
				&nbsp;&mdash; how few numbers does a galaxy's spectrum really need?
			</span>
		</p>
	</section>
</PageLayout>
