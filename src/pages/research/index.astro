---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import PageTitle from "@/components/PageTitle.astro";
import PublicationList from "@/components/PublicationList.astro";
import PageLayout from "@/layouts/Base.astro";
import { papers, publicationProfiles, theses } from "@/data/publications";

const entries = (await getCollection("research", ({ data }) => !data.draft)).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<PageLayout meta={{ title: "Research", description: "Galaxy luminosity functions, semi-analytic models, stellar populations and dark matter." }}>
	<PageTitle title="Research" />

	<div data-pagefind-body>
		<ul class="space-y-14" role="list">
			{
				entries.map((entry) => (
					<li class="grid gap-5 sm:grid-cols-[9rem_1fr] sm:gap-6">
						<a class="block" href={`/research/${entry.id}/`} tabindex="-1" aria-hidden="true">
							<Image
								class="bg-global-bg rounded-sm border border-black/5 dark:border-white/10"
								src={entry.data.figure.src}
								alt=""
								widths={[144, 288]}
								sizes="9rem"
								loading="lazy"
							/>
						</a>
						<div>
							<h2 class="text-lg leading-snug">
								<a class="cactus-link" href={`/research/${entry.id}/`}>
									{entry.data.shortTitle ?? entry.data.title}
								</a>
							</h2>
							<p class="text-muted mt-1 text-xs">{entry.data.venue}</p>
							<p class="mt-2 text-sm leading-relaxed text-pretty">{entry.data.hook}</p>
							{entry.data.demo && (
								<p class="mt-3">
									<a
										class="border-accent/50 text-accent hover:border-accent hover:bg-accent/5 rounded-sm border px-2.5 py-1 text-xs transition-colors"
										href={entry.data.demo}
									>
										&#9654; Try the interactive version
									</a>
								</p>
							)}
						</div>
					</li>
				))
			}
		</ul>

		<section class="mt-20">
			<h2 class="title mb-2 text-xl" id="publications">Publications</h2>
			<p class="text-muted mb-8 text-xs">
				Full list on {
					publicationProfiles.map(({ label, href }, i) => (
						<>
							{i > 0 && (i === publicationProfiles.length - 1 ? " and " : ", ")}
							<a class="cactus-link" href={href} rel="noreferrer" target="_blank">
								{label}
							</a>
						</>
					))
				}.
			</p>
			<PublicationList items={papers} />

			<h3 class="title mt-12 mb-6 text-base">Theses</h3>
			<PublicationList items={theses} start={1} />
		</section>
	</div>
</PageLayout>
