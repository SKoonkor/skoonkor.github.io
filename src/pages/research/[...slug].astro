---
import { Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import PageTitle from "@/components/PageTitle.astro";
import PageLayout from "@/layouts/Base.astro";

export const getStaticPaths = (async () => {
	const entries = await getCollection("research", ({ data }) => !data.draft);
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { demo, figure, hook, links, shortTitle, title, venue } = entry.data;
---

<PageLayout
	meta={{
		title: shortTitle ?? title,
		description: hook,
		ogImage: `/og-image/${entry.id}.png`,
		articleDate: entry.data.publishDate.toISOString(),
	}}
>
	{/*
		The heading carries the short title with the full academic one below it.
		Once stuck the bar falls back to the section name: prefixing the site name
		onto a 56-character paper title makes a string no phone can render.
	*/}
	<PageTitle
		title={shortTitle ?? title}
		subtitle={shortTitle ? title : undefined}
		stuckLabel="Research"
	/>

	<article data-pagefind-body>
		<p class="text-muted -mt-6 mb-8 text-xs">{venue}</p>

		<figure class="mb-10">
			<Image
				class="bg-global-bg mx-auto rounded-sm border border-black/5 dark:border-white/10"
				src={figure.src}
				alt={figure.alt}
				widths={[480, 768, 1024]}
				sizes="(min-width: 768px) 768px, 100vw"
				loading="eager"
			/>
			{
				figure.caption && (
					<figcaption class="text-muted mt-3 text-xs leading-relaxed">{figure.caption}</figcaption>
				)
			}
		</figure>

		<p class="mb-10 text-base leading-relaxed text-pretty">{hook}</p>

		{
			(links.length > 0 || demo) && (
				<p class="mb-10 flex flex-wrap gap-2">
					{demo && (
						<a
							class="border-accent/50 text-accent hover:border-accent hover:bg-accent/5 rounded-sm border px-2.5 py-1 text-xs transition-colors"
							href={demo}
						>
							&#9654; Try the interactive version
						</a>
					)}
					{links.map(({ label, href }) => (
						<a
							class="border-muted/40 hover:border-accent hover:text-accent rounded-sm border px-2.5 py-1 text-xs transition-colors"
							href={href}
							rel="noreferrer"
							target="_blank"
						>
							{label}
						</a>
					))}
				</p>
			)
		}

		<div class="prose prose-sm prose-cactus max-w-none">
			<Content />
		</div>
	</article>

	<p class="mt-16">
		<a class="cactus-link text-sm" href="/research/">&larr; All research</a>
	</p>
</PageLayout>
