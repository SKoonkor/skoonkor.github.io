---
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import PageTitle from "@/components/PageTitle.astro";
import { courses } from "@/data/courses";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import "@/styles/explore.css";

const notes = (await getCollection("post", ({ data }) => !data.draft)).sort(collectionDateSort);

const meta = {
	title: "Notes",
	description: "Notes written as I learn a subject, from full lecture courses to shorter write-ups, for anyone else learning it too.",
};
---

<PageLayout bands="static" meta={meta}>
	<PageTitle title="Notes" />

	<div data-pagefind-body>
		<p class="mb-10 text-base leading-relaxed text-pretty">
			I write these up as I learn the material myself. If you read them and spot any incorrect
			physics or derivations, please let me know. I would greatly appreciate it.
		</p>

		<ul class="explore-cards" role="list">
			{
				courses.map(({ href, title }) => (
					<li>
						<a href={href}>
							<h2 style="margin-bottom: 0">{title}</h2>
						</a>
					</li>
				))
			}
		</ul>

		{
			notes.length > 0 && (
				<section class="mt-20">
					<h2 class="title mb-6 text-xl">Written</h2>
					<ul class="space-y-4" role="list">
						{notes.map((note) => (
							<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
								<FormattedDate
									class="text-muted min-w-30 font-semibold"
									date={note.data.publishDate}
								/>
								<div>
									<a class="cactus-link" href={`/explore/notes/${note.id}/`}>
										{note.data.title}
									</a>
									<p class="text-muted mt-0.5 text-xs leading-relaxed text-pretty">
										{note.data.description}
									</p>
								</div>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</div>
</PageLayout>
